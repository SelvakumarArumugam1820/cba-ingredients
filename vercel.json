{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/sustainable-supply", "destination": "/sustainable-supply/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)\.(png|jpg|jpeg|webp|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(favicon.ico|favicon.png|apple-touch-icon.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
